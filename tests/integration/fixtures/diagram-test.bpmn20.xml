      <bpmndi:BPMNShape id="BPMNShape_wait" bpmnElement="wait">
        <omgdc:Bounds height="60" width="100" x="170" y="148"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <omgdc:Bounds height="28" width="28" x="320" y="164"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
        <omgdi:waypoint x="130" y="178"/>
        <omgdi:waypoint x="170" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
        <omgdi:waypoint x="270" y="178"/>
        <omgdi:waypoint x="320" y="178"/>
      </bpmndi:BPMNEdge>

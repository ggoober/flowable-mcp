<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:flowable="http://flowable.org/bpmn"
  targetNamespace="http://www.flowable.org/processdef">

  <message id="testMessage" name="testMessage"/>

  <process id="message-event-process" name="Message Event Process" isExecutable="true">
    <startEvent id="start" name="Start"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="catchMsg"/>
    <intermediateCatchEvent id="catchMsg" name="Catch Message">
      <messageEventDefinition messageRef="testMessage"/>
    </intermediateCatchEvent>
    <sequenceFlow id="flow2" sourceRef="catchMsg" targetRef="end"/>
    <endEvent id="end" name="End"/>
  </process>

</definitions>
